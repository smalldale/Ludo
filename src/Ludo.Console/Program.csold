List<IPlayer> GetInitializePlayers()
{
    int id = 1;
    List<IPlayer> players = [];

    Dictionary<string, PlayerColor> playerColorChoices = new()
    {
        { "R", PlayerColor.Red },
        { "G", PlayerColor.Green },
        { "B", PlayerColor.Blue },
        { "Y", PlayerColor.Yellow }
    };

    while (players.Count < 4)
    {
        Console.Write($"Enter player {players.Count + 1} name");

        if (players.Count >= 2)
            Console.Write(" (press Enter to finish)");

        Console.Write(": ");

        string? name = Console.ReadLine();

        // Allow finishing once there are at least 2 players
        if (string.IsNullOrWhiteSpace(name))
        {
            if (players.Count >= 2)
                break;

            Console.WriteLine("You need at least 2 players.");
            continue;
        }

        PlayerColor color;

        while (true)
        {
            // Get colors that have not been chosen
            var availableColors = playerColorChoices
                .Where(c => !players.Any(p => p.Color == c.Value))
                .ToDictionary(c => c.Key, c => c.Value);
            Console.WriteLine($"Available colors: {string.Join(", ", availableColors.Keys)}");
            Console.Write("Choose player color: ");
            string? input = Console.ReadLine()?.Trim().ToUpper();

            if (input != null &&
                playerColorChoices.TryGetValue(input, out color))
            {
                // Check if another player already uses this color
                if (players.Any(p => p.Color == color))
                {
                    Console.WriteLine("This color has already been chosen. Pick another.");
                    continue;
                }

                break;
            }
            Console.WriteLine("Invalid or unavailable color. Please choose an available color.");
        }

        players.Add(new Player(id++, name, color));
    }

    return players;
}

void StandardCLIPlay()
{
    List<IPlayer> players = GetInitializePlayers();
    GameController game = new GameController(players);
    SubscribeEvent(game);
    game.StartGame();

    while (game.Phase != TurnPhase.Finished)
    {
        // DrawBoard((Board)game.board, game, players);
        IPlayer currentPlayer = game.GetCurrentPlayer();
        Console.Write($"{currentPlayer.Color} player {currentPlayer.Name} can roll dice, press enter to roll... ");
        Console.ReadLine();
        game.RollDice(currentPlayer.Id);
        if (game.Phase == TurnPhase.WaitingForMove)
        {
            var positions = game.GetMovablePositions();

            if (positions.Count > 0)
            {
                SelectAndMovePiece(game, currentPlayer);
            }
        }
        DrawBoard((Board)game.board, game, players);
        Console.ReadLine();
    }
    
    Console.WriteLine("\n=== FINAL RANKINGS ===");
    for (int i = 0; i < game.Rankings.Count; i++)
    {
        Console.WriteLine(
            $"{i + 1}. {game.Rankings[i].Name} ({game.Rankings[i].Color})");
    }
    IPlayer lastPlayer = players
        .First(p => !game.Rankings.Any(r => r.Id == p.Id));
    Console.WriteLine(
        $"Last place: {lastPlayer.Name} ({lastPlayer.Color})");
}


void AutoPlay(int playerCount = 4)
{
    if (playerCount < 2 || playerCount > 4)
        throw new ArgumentOutOfRangeException(
            nameof(playerCount), "Player count must be between 2 and 4.");

    PlayerColor[] colors =
    [
        PlayerColor.Red,
        PlayerColor.Green,
        PlayerColor.Blue,
        PlayerColor.Yellow
    ];

    List<IPlayer> players = Enumerable.Range(1, playerCount)
        .Select(i => (IPlayer)new Player(
            i,
            $"AI-{colors[i - 1]}",
            colors[i - 1]))
        .ToList();

    GameController game = new GameController(players);

    // SubscribeEvent(game);
    game.OnPlayerFinished += (playerId, rank) =>
        Console.WriteLine(
            $"[FINISH] {game.GetPlayer(playerId).Name} placed #{rank}");

    game.OnGameEnded += _ =>
        Console.WriteLine("[GAME ENDED]");

    game.StartGame();

    Random random = new Random();
    int maxActions = 90_000;

    while (game.Phase != TurnPhase.Finished && maxActions-- > 0)
    {
        IPlayer currentPlayer = game.GetCurrentPlayer();

        if (game.Phase == TurnPhase.WaitingForRoll)
        {
            game.RollDice(currentPlayer.Id);
            continue;
        }

        if (game.Phase == TurnPhase.WaitingForMove)
        {
            var movablePositions = game.GetMovablePositions();

            var movablePieces = GetPlayerPieces(game, currentPlayer)
                .Where(p => movablePositions.Contains(game.GetPosition(p)))
                .ToList();

            if (movablePieces.Count == 0)
                continue;

            IPiece selectedPiece =
                movablePieces[random.Next(movablePieces.Count)];

            MoveResult result = game.MovePieceById(
                currentPlayer.Id,
                selectedPiece.Id);

            if (!result.Success)
                throw new InvalidOperationException(result.Error);
        }
    }

    if (maxActions <= 0)
        Console.WriteLine("Stopped: action limit reached.");

    Console.WriteLine("\n=== FINAL RANKINGS ===");

    for (int i = 0; i < game.Rankings.Count; i++)
    {
        IPlayer player = game.Rankings[i];
        Console.WriteLine(
            $"{i + 1}. {player.Name} ({player.Color})");
    }

    IPlayer? lastPlayer = players.FirstOrDefault(
        p => !game.Rankings.Any(r => r.Id == p.Id));

    if (lastPlayer != null)
        Console.WriteLine($"Last place: {lastPlayer.Name} ({lastPlayer.Color})");
}


StandardCLIPlay();
