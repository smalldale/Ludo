using Ludo.Core.Application;
using Ludo.Core.Domain;
using Ludo.Core.Domain.Interfaces;
using Ludo.Core.Domain.Enums;

//https://ludoking.com/play/

void SubscribeEvent(GameController game)
{
    game.OnDiceRolled += (playerId, roll) =>
        Console.WriteLine($"[event] {game.GetPlayer(playerId).Color} Player {game.GetPlayer(playerId).Name}, rolled {roll}.");
    game.OnPieceCaptured += victimPieceId =>
        Console.WriteLine($"[event] {game.GetPiece(victimPieceId).Color} Piece {victimPieceId} has been captured, go to base.");
    game.OnPieceMoved += (pieceId, position) =>
        Console.WriteLine($"[event] {game.GetPiece(pieceId).Color} Piece moved to {position}.");
    game.OnTurnChanged += (currentPlayerId) =>
        Console.WriteLine($"[event] Now {game.GetPlayer(currentPlayerId).Color} player {game.GetPlayer(currentPlayerId).Name} turn (turn {game.Turn}, sixes {game.ConsecutiveSixes}).");
    game.OnGameEnded += playerId =>
        Console.WriteLine($"[event] Player {game.GetPlayer(playerId)} WIN. GAME ENDED.");
    game.OnPlayerFinished += (playerId, rank) =>
        Console.WriteLine($"[event] {game.GetPlayer(playerId).Name} finished in place #{rank}!");
}

List<IPiece> GetPlayerPieces(GameController game, IPlayer player)
{
    return Enumerable.Range(0, 4)
        .Select(i => (player.Id - 1) * 4 + i + 1)
        .Select(pieceId => game.GetPiece(pieceId))
        .ToList();
}

