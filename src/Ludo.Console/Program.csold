static string CenteredText(string text, int width)
{
    int leftPadding = (width - text.Length) / 2 + text.Length;
    return text.PadLeft(leftPadding).PadRight(width);
}

void DrawBoard(Board board, GameController game, IEnumerable<IPlayer> players)
{
    int size = Board.Size;
    var grid = new string[size, size];

    // Draw the underlying board.
    for (int row = 0; row < size; row++)
    {
        for (int col = 0; col < size; col++)
        {
            ICell? cell = board.Cells[row, col];

            grid[row, col] = cell is null
                ? "   "
                : cell.Type switch
                {
                    CellType.Safe => " * ",
                    _ => " . "
                };
        }
    }

    // Overlay pieces using their actual coordinates.
    foreach (Player player in players)
    {
        foreach (IPiece piece in GetPlayerPieces(game, player))
        {
            Coordinate coordinate = game.FindCell(piece.Id);

            // Skip coordinates that are not on the 15x15 board.
            if (coordinate.Row < 0 || coordinate.Row >= size ||
                coordinate.Col < 0 || coordinate.Col >= size)
            {
                continue;
            }

            string symbol = player.Color switch
            {
                PlayerColor.Red => "R",
                PlayerColor.Green => "G",
                PlayerColor.Yellow => "Y",
                PlayerColor.Blue => "B",
                _ => "?"
            };

            string current = grid[coordinate.Row, coordinate.Col];

            // Show a count if multiple pieces share a cell.
            grid[coordinate.Row, coordinate.Col] =
                current.Length == 1 &&
                current != "." &&
                current != "*" &&
                current != " "
                    ? $"{CenteredText("*", 3)}"
                    : $"{CenteredText(symbol+piece.Id, 3)}";
        }
    }

    // Print column headers.
    Console.Write("   ");
    for (int col = 0; col < size; col++)
        Console.Write($"{col,4} ");

    Console.WriteLine();

    for (int row = 0; row < size; row++)
    {
        Console.Write($"{row,2} ");

        for (int col = 0; col < size; col++)
            Console.Write($" {grid[row, col]} ");

        Console.WriteLine();
    }
}

void SelectAndMovePiece(GameController game, IPlayer player)
{
    var movablePositions = game.GetMovablePositions();

    var movablePieces = GetPlayerPieces(game, player)
        .Where(p => movablePositions.Contains(game.GetPosition(p)))
        .OrderBy(p => p.Id)
        .ToList();

    if (movablePieces.Count == 0)
        return;

    // Automatically move only when exactly one piece is movable,
    // it is not in Base, and its square contains only one piece.
    if (movablePieces.Count == 1)
    {
        IPiece piece = movablePieces[0];
        Coordinate coordinate = game.FindCell(piece.Id);

        bool isInBase = game.GetPieceState(piece) == PieceState.Base;
        bool isStacked = game.board.Cells[coordinate.Row, coordinate.Col]
            .Pieces.Count > 1;

        if (!isInBase && !isStacked)
        {
            MoveResult automaticResult =
                game.MovePieceById(player.Id, piece.Id);

            if (!automaticResult.Success)
                throw new InvalidOperationException(automaticResult.Error);

            return;
        }
    }

    Console.WriteLine("\nChoose a piece to move:");

    for (int i = 0; i < movablePieces.Count; i++)
    {
        IPiece piece = movablePieces[i];
        int position = game.GetPosition(piece);
        Coordinate coordinate = game.FindCell(piece.Id);

        string state = game.GetPieceState(piece) == PieceState.Base
            ? "Base"
            : $"Position {position}";

        Console.WriteLine(
            $"{i + 1}. Piece #{piece.Id} | {state} | " +
            $"Board ({coordinate.Row}, {coordinate.Col})");
    }

    while (true)
    {
        Console.Write($"Select a piece (1-{movablePieces.Count}): ");

        if (int.TryParse(Console.ReadLine(), out int choice) &&
            choice >= 1 && choice <= movablePieces.Count)
        {
            MoveResult result =
                game.MovePieceById(player.Id, movablePieces[choice - 1].Id);

            if (!result.Success)
                throw new InvalidOperationException(result.Error);

            return;
        }

        Console.WriteLine("Invalid selection. Try again.");
    }
}

